+spy_str_gc_alloc(size_t length) {
+    spy_StrObject *res = (spy_StrObject *)spy_gc_alloc_pointerless(sizeof(spy_StrObject) + length);
+    spy_str_init(res, length);
+    return res;
+}
+
+static inline spy_StrObject *
+spy_str_gc_realloc(spy_StrObject *p, size_t length) {
+    spy_StrObject *res =
+        (spy_StrObject *)spy_gc_realloc_pointerless(p, sizeof(spy_StrObject) + length);
