+@UNSAFE.builtin_func(color="blue", kind="generic")
+def w_gc_realloc(vm: "SPyVM", w_T: W_Type, *args_w: W_Dynamic) -> W_Dynamic:
+    # gc_realloc[T](p, n): resize the buffer pointed to by p to hold n items
+    # of T, moving the contents if necessary. Returns a new gc_ptr[T].
+    #
+    # Quick&dirty implementation: only natural alignment is supported.
+    # The C equivalent (Ptr$realloc) is generated by SPY_PTR_FUNCTIONS in
+    # spy/libspy/include/spy/unsafe.h.
+    alignment = parse_optional_alignment(vm, w_T, args_w, "gc_realloc")
+    if alignment != NATURAL_ALIGNMENT:
+        raise WIP("gc_realloc: over-aligned buffers are not supported yet")
+    w_ptrtype = vm.fast_call(w_gc_ptr, [w_T])
+    assert isinstance(w_ptrtype, W_PtrType)
+    ITEMSIZE = sizeof(w_T)
+    P = Annotated[W_Ptr, w_ptrtype]
+
+    @vm.register_builtin_func(w_ptrtype.fqn, "realloc")
+    def w_fn(vm: "SPyVM", w_p: P, w_n: W_I32) -> P:
+        n = vm.unwrap_i32(w_n)
+        assert isinstance(w_p, W_Ptr)
+        size = ITEMSIZE * n
+        addr = vm.ll.call("spy_nogc_realloc", w_p.addr, size)
+        return W_Ptr(w_ptrtype, addr, n)  # type: ignore
+
+    return w_fn
+
