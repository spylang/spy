+def w__realloc_StrObject(
+    vm: "SPyVM", wam_p: W_MetaArg, wam_length: W_MetaArg
+) -> W_OpSpec:
+    """
+    Resize a StrObject allocated by `_alloc_StrObject` so that its utf8 buffer
+    holds `length` bytes. The object may move, and `utf8` is updated to point
+    to the new buffer.
+    """
