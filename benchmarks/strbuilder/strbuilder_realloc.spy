"""
ReallocStrBuilder: a single growable StrObject, CPython _PyUnicodeWriter style.

    sb = ReallocStrBuilder(capacity)
    sb.append("hello ")
    s = sb.build()

The buffer is the final string: growth calls StrObject.realloc (which moves the
object and fixes `utf8`), and build() is a logical shrink plus a cast. The
first growth is exact, the following ones are geometric (see GROWTH_DIVISOR).

Same API and safety model as ChunkedStrBuilder: a wrapper around a
gc_ptr[State] shared by all the copies, sealed by build().

NOTE: StrObject.realloc is not in upstream SPy, so growth is alloc + copy + drop the
old buffer: with Boehm that is what most reallocs do anyway.
"""

from __spy__ import force_inline
from _str import StrObject
from unsafe import gc_alloc, gc_ptr, ptr_copy_slice

# grow by 1/GROWTH_DIVISOR of the new size: 1 means doubling. CPython uses 4
# (+25%), because it relies on glibc realloc; with Boehm most growths copy, and
# in the benchmarks doubling wins over 1.5x and 1.25x.
GROWTH_DIVISOR = 1


@struct
class ReallocState:
    buf: gc_ptr[StrObject]  # buf.length is the capacity; NULL when built
    pos: i32
    first_growth: bool


@struct
class ReallocStrBuilder:
    __ll__: gc_ptr[ReallocState]

    def __new__(capacity: i32) -> ReallocStrBuilder:
        if capacity < 0:
            raise ValueError("StrBuilder capacity must not be negative")
        state = gc_alloc[ReallocState](1)
        state.buf = StrObject.alloc(capacity)
        state.pos = 0
        state.first_growth = True
        return ReallocStrBuilder.__make__(state)

    def is_built(self) -> bool:
        return self.__ll__.buf == gc_ptr[StrObject].NULL

    def length(self) -> i32:
        state = self.__ll__
        if state.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        return state.pos

    def _grow(self, needed: i32) -> None:
        state = self.__ll__
        newcap = state.pos + needed
        if state.first_growth:
            state.first_growth = False
        else:
            newcap += newcap // GROWTH_DIVISOR
        newbuf = StrObject.alloc(newcap)
        ptr_copy_slice(newbuf.utf8, 0, state.pos, state.buf.utf8, 0, state.pos)
        state.buf = newbuf

    @force_inline
    def append(self, chunk: str) -> None:
        state = self.__ll__
        if state.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        src = StrObject.from_str(chunk)
        n = src.length
        if state.pos + n > state.buf.length:
            self._grow(n)
        ptr_copy_slice(state.buf.utf8, state.pos, state.pos + n, src.utf8, 0, n)
        state.pos += n

    def build(self) -> str:
        state = self.__ll__
        buf = state.buf
        if buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        state.buf = gc_ptr[StrObject].NULL
        buf.length = state.pos
        return StrObject.to_sealed_str(buf)
