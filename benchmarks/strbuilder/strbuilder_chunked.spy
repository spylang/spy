"""
ChunkedStrBuilder: build a `str` piece by piece.

    sb = ChunkedStrBuilder(capacity)
    sb.append("hello ")
    sb.append("world")
    s = sb.build()

`capacity` is the size in bytes of the first chunk. It is a hint: if it is at
least the final size of the string, nothing is ever copied and build() is a
cast; if it is too small, the builder grows; if it is too big, the slack is
dropped by build().

How it works
------------
The builder is a chain of chunks, each one a StrObject. The chunk being filled
is `cur`; the chunks which are already closed are a singly linked list of
`Piece`, newest first, reachable from `prev` (every link points to the
previous, i.e. older, piece):

    state.cur  --> [current chunk]
    state.prev --> Piece C --prev--> Piece B --prev--> Piece A --> NULL

Growth never copies old data: the current chunk is closed and linked into the
chain, and a new chunk is allocated, as big as everything written so far (so
the number of chunks is logarithmic in the size of the string). A str which
is big and doesn't fit is linked as a piece as it is, without copying it.

build() returns `cur` itself (a cast, no copy) if nothing ever overflowed the
first chunk, else it concatenates the chain into a new str, back to front.

Safety
------
ChunkedStrBuilder is a thin wrapper around a gc_ptr[BuilderState]: SPy structs are
immutable values, so the mutable state lives behind the pointer, and all
copies of a ChunkedStrBuilder share it. build() seals the state (cur = NULL), so
any later append() or build() through any alias raises ValueError: the
resulting str can never be modified.

NOTE: not thread safe. A builder must not be shared between threads.
"""

from __spy__ import force_inline
from _str import StrObject
from unsafe import gc_alloc, gc_ptr, ptr_copy_slice

# Tunable parameters: the defaults are on a plateau, see README.md
#
# A new chunk has size  total * GROWTH_NUM // GROWTH_DEN + n,  where `total` is
# the number of bytes written so far and `n` is the size of the append which
# didn't fit. It is rounded up to a multiple of CHUNK_ROUND and it is at least
# MIN_CHUNK. GROWTH 1/1 makes the number of chunks logarithmic in the size.
GROWTH_NUM = 1
GROWTH_DEN = 1
CHUNK_ROUND = 64
MIN_CHUNK = 0

# a str at least this big which doesn't fit in the current chunk is linked as a
# piece, instead of being copied
ADOPT_THRESHOLD = 4096


@struct
class Piece:
    buf: gc_ptr[StrObject]
    used: i32  # bytes used in buf
    prev: gc_ptr[Piece]


@struct
class BuilderState:
    cur: gc_ptr[StrObject]  # cur.length is the capacity; NULL when built
    cur_pos: i32  # bytes used in cur
    prev_total: i32  # bytes stored in the chain starting at `prev`
    prev: gc_ptr[Piece]


@struct
class ChunkedStrBuilder:
    __ll__: gc_ptr[BuilderState]

    def __new__(capacity: i32) -> ChunkedStrBuilder:
        if capacity < 0:
            raise ValueError("ChunkedStrBuilder capacity must not be negative")
        state = gc_alloc[BuilderState](1)
        state.cur = StrObject.alloc(capacity)
        state.cur_pos = 0
        state.prev_total = 0
        state.prev = gc_ptr[Piece].NULL
        return ChunkedStrBuilder.__make__(state)

    def is_built(self) -> bool:
        return self.__ll__.cur == gc_ptr[StrObject].NULL

    def length(self) -> i32:
        state = self.__ll__
        if state.cur == gc_ptr[StrObject].NULL:
            raise ValueError("ChunkedStrBuilder is already built")
        return state.cur_pos + state.prev_total

    def _append_slow(self, src: gc_ptr[StrObject], n: i32) -> None:
        """
        `src` (n bytes) doesn't fit in the current chunk.
        """
        state = self.__ll__
        if n >= ADOPT_THRESHOLD and state.cur_pos == 0:
            # the current chunk is empty, so we can link src itself as the
            # newest piece without breaking the order
            piece = gc_alloc[Piece](1)
            piece.buf = src
            piece.used = n
            piece.prev = state.prev
            state.prev = piece
            state.prev_total += n
            return
        total = state.prev_total + state.cur_pos
        if state.cur_pos > 0:
            piece = gc_alloc[Piece](1)
            piece.buf = state.cur
            piece.used = state.cur_pos
            piece.prev = state.prev
            state.prev = piece
        state.prev_total = total
        size = total // GROWTH_DEN * GROWTH_NUM + n
        if size < MIN_CHUNK:
            size = MIN_CHUNK
        size = (size + CHUNK_ROUND - 1) // CHUNK_ROUND * CHUNK_ROUND
        state.cur = StrObject.alloc(size)
        ptr_copy_slice(state.cur.utf8, 0, n, src.utf8, 0, n)
        state.cur_pos = n

    @force_inline
    def append(self, chunk: str) -> None:
        state = self.__ll__
        if state.cur == gc_ptr[StrObject].NULL:
            raise ValueError("ChunkedStrBuilder is already built")
        src = StrObject.from_str(chunk)
        n = src.length
        if n > state.cur.length - state.cur_pos:
            self._append_slow(src, n)
        else:
            ptr_copy_slice(
                state.cur.utf8, state.cur_pos, state.cur_pos + n, src.utf8, 0, n
            )
            state.cur_pos += n

    def build(self) -> str:
        """
        Return the string and seal the builder.
        """
        state = self.__ll__
        cur = state.cur
        if cur == gc_ptr[StrObject].NULL:
            raise ValueError("ChunkedStrBuilder is already built")
        state.cur = gc_ptr[StrObject].NULL
        if state.prev == gc_ptr[Piece].NULL:
            # nothing overflowed the first chunk: the chunk is the result
            cur.length = state.cur_pos
            return StrObject.to_str(cur)
        total = state.prev_total + state.cur_pos
        result = StrObject.alloc(total)
        dst = total - state.cur_pos
        ptr_copy_slice(result.utf8, dst, total, cur.utf8, 0, state.cur_pos)
        piece = state.prev
        while piece != gc_ptr[Piece].NULL:
            dst -= piece.used
            ptr_copy_slice(
                result.utf8, dst, dst + piece.used, piece.buf.utf8, 0, piece.used
            )
            piece = piece.prev
        return StrObject.to_str(result)
