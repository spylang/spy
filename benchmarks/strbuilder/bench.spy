"""
Benchmark of the StrBuilder implementations in this directory. Columns:

  realloc        strbuilder_realloc.spy       one growable StrObject (CPython style)
  chunked        strbuilder_chunked.spy       chunk list (linked), behind a gc_ptr[State]
  chunked-exact  strbuilder_chunked.spy       the same, created with the exact final size
  list           strbuilder_chunked_list.spy  chunk list stored in a list[Piece]
  fn             strbuilder_fn.spy            chunk list in a plain value, `sb = sb.append(x)`
  unsafe         strbuilder_unsafe_fixed.spy  fixed capacity (the exact size), no checks
  std            stdlib/strbuilder.spy        StrBuilder, same capacity as `chunked`
  std-exact      stdlib/strbuilder.spy        StrBuilder, created with the exact final size
  std-unsafe     stdlib/strbuilder.spy        UnsafeFixedStrBuilder, exact size

Run it with:

    spy build -x --release benchmarks/strbuilder/bench.spy

Each number is the best of several runs, in microseconds. The result of every
run is checked to be identical for all the builders. Run it on AC power: on
battery the timings are very noisy.

Sections:
  1. synthetic: 1 MB built from equal appends, only the size of each append changes
  2. real-life: the output of a JSON / CSV writer, one .append per token
  3. repr of a short list, starting from a small default capacity
  4. repr of list[int] / list[float] with exact capacity, an underestimate and
     an overestimate (the exact pre-pass is part of the timed region)
"""

from time import time
from strbuilder_chunked import ChunkedStrBuilder
from strbuilder_chunked_list import ChunkedListStrBuilder
from strbuilder_fn import FnStrBuilder
from strbuilder_realloc import ReallocStrBuilder
from strbuilder_unsafe_fixed import UnsafeFixedStrBuilder
from strbuilder import StrBuilder, UnsafeFixedStrBuilder as StdUnsafeBuilder


SIZE_BYTES = 1024 * 1024
REPS = 5
DEFAULT_CAPACITY = 64

# ------------------------------------------------------------------ reporting


def fmt(us: f64) -> str:
    if us < 0.0:
        return "      -"
    whole = i32(us)
    frac = i32((us - f64(whole)) * 10.0)
    s = f"{whole}.{frac}"
    return " " * (7 - len(s)) + s


def row(
    label: str, r: f64, c: f64, ce: f64, l: f64, f: f64, u: f64, s: f64, se: f64, su: f64
) -> None:
    print(
        f"{label}: realloc {fmt(r)}   chunked {fmt(c)}   chunked-exact {fmt(ce)}"
        f"   list {fmt(l)}   fn {fmt(f)}   unsafe {fmt(u)}"
        f"   std {fmt(s)}   std-exact {fmt(se)}   std-unsafe {fmt(su)}"
    )


def header(title: str) -> None:
    print()
    print(title)


# ------------------------------------------------------------------ 1. append size
#
# Synthetic: append the same piece again and again until the string is 1 MB.
# The content is irrelevant, the only thing which changes between the rows is
# the size of each append: from per-append overhead (2B) to memcpy (4KB).


def pattern_r(src: str) -> str:
    b = ReallocStrBuilder(DEFAULT_CAPACITY)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b.append(src[0:remaining])
    return b.build()


def pattern_f(src: str) -> str:
    b = FnStrBuilder(DEFAULT_CAPACITY)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b = b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b = b.append(src[0:remaining])
    return b.build()


def pattern_c(src: str, cap: i32) -> str:
    b = ChunkedStrBuilder(cap)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b.append(src[0:remaining])
    return b.build()


def pattern_l(src: str) -> str:
    b = ChunkedListStrBuilder(DEFAULT_CAPACITY)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b.append(src[0:remaining])
    return b.build()


def pattern_u(src: str) -> str:
    b = UnsafeFixedStrBuilder(SIZE_BYTES)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b = b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b = b.append(src[0:remaining])
    return b.build()


def pattern_s(src: str, cap: i32) -> str:
    b = StrBuilder(cap)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b.append(src[0:remaining])
    return b.build()


def pattern_su(src: str) -> str:
    b = StdUnsafeBuilder(SIZE_BYTES)
    remaining = SIZE_BYTES
    while remaining > len(src):
        b.append(src)
        remaining -= len(src)
    if remaining > 0:
        b.append(src[0:remaining])
    return b.build()


def bench_pattern(name: str, append_size: i32) -> None:
    src = "x" * append_size
    best_r = 1e18
    best_c = 1e18
    best_ce = 1e18
    best_l = 1e18
    best_f = 1e18
    best_u = 1e18
    best_s = 1e18
    best_se = 1e18
    best_su = 1e18
    for rep in range(REPS):
        t0 = time()
        res_r = pattern_r(src)
        t1 = time()
        res_c = pattern_c(src, DEFAULT_CAPACITY)
        t2 = time()
        res_ce = pattern_c(src, SIZE_BYTES)
        t3 = time()
        res_l = pattern_l(src)
        t4 = time()
        res_f = pattern_f(src)
        t5 = time()
        res_u = pattern_u(src)
        t6 = time()
        res_s = pattern_s(src, DEFAULT_CAPACITY)
        t7 = time()
        res_se = pattern_s(src, SIZE_BYTES)
        t8 = time()
        res_su = pattern_su(src)
        t9 = time()
        assert res_c == res_s
        assert res_c == res_se
        assert res_c == res_su
        assert len(res_c) == SIZE_BYTES
        assert res_c == res_r
        assert res_c == res_ce
        assert res_c == res_l
        assert res_c == res_f
        assert res_c == res_u
        best_r = min(best_r, t1 - t0)
        best_c = min(best_c, t2 - t1)
        best_ce = min(best_ce, t3 - t2)
        best_l = min(best_l, t4 - t3)
        best_f = min(best_f, t5 - t4)
        best_u = min(best_u, t6 - t5)
        best_s = min(best_s, t7 - t6)
        best_se = min(best_se, t8 - t7)
        best_su = min(best_su, t9 - t8)
    row(
        name,
        best_r * 1e6,
        best_c * 1e6,
        best_ce * 1e6,
        best_l * 1e6,
        best_f * 1e6,
        best_u * 1e6,
        best_s * 1e6,
        best_se * 1e6,
        best_su * 1e6,
    )


def section_append_size() -> None:
    header("1. 1 MB built from equal appends, us (chunked-exact and unsafe have the exact capacity)")
    bench_pattern("append-2B   ", 2)
    bench_pattern("append-16B  ", 16)
    bench_pattern("append-128B ", 128)
    bench_pattern("append-1KB  ", 1024)
    bench_pattern("append-4KB  ", 4096)


# ------------------------------------------------------------------ 2. writers
#
# Real-life: the output of a JSON / CSV writer. In the "prepare" part (not
# timed) we generate the list of pieces which a writer would append, one
# piece per .append(): punctuation, keys, quotes, formatted numbers. The timed
# part just appends them all, in order.
#
# unsafe and chunked-exact are given the exact total size: a real writer would
# not know it, so they are the "if only we knew" bound.


def ival(i: i32) -> i32:
    return (i * 7919) % 100000


def fval(i: i32) -> f64:
    return f64(ival(i)) * 0.37


def push(parts: list[str], s: str) -> i32:
    parts.append(s)
    return len(s)


def make_json_parts(target: i32) -> list[str]:
    """
    [{"id": 1, "name": "user_1", "score": 3.7}, {...}, ...] until the document
    is at least `target` bytes.
    """
    parts: list[str] = []
    total = push(parts, "[")
    i = 0
    while total < target:
        if i > 0:
            total += push(parts, ", ")
        total += push(parts, "{")
        total += push(parts, '"id"')
        total += push(parts, ": ")
        total += push(parts, str(i))
        total += push(parts, ", ")
        total += push(parts, '"name"')
        total += push(parts, ": ")
        total += push(parts, '"')
        total += push(parts, f"user_{i}")
        total += push(parts, '"')
        total += push(parts, ", ")
        total += push(parts, '"score"')
        total += push(parts, ": ")
        total += push(parts, f"{fval(i)}")
        total += push(parts, "}")
        i += 1
    total += push(parts, "]")
    return parts


def make_csv_parts(target: i32) -> list[str]:
    """
    id,name,score,comment
    1,user_1,3.7,"some text, with a comma"
    ...
    until the document is at least `target` bytes.
    """
    parts: list[str] = []
    total = push(parts, "id")
    total += push(parts, ",")
    total += push(parts, "name")
    total += push(parts, ",")
    total += push(parts, "score")
    total += push(parts, ",")
    total += push(parts, "comment")
    total += push(parts, "\n")
    i = 0
    while total < target:
        total += push(parts, str(i))
        total += push(parts, ",")
        total += push(parts, f"user_{i}")
        total += push(parts, ",")
        total += push(parts, f"{fval(i)}")
        total += push(parts, ",")
        total += push(parts, '"')
        total += push(parts, "some text, with a comma")
        total += push(parts, '"')
        total += push(parts, "\n")
        i += 1
    return parts


def total_len(parts: list[str]) -> i32:
    total = 0
    for p in parts:
        total += len(p)
    return total


def parts_r(parts: list[str]) -> str:
    b = ReallocStrBuilder(DEFAULT_CAPACITY)
    for p in parts:
        b.append(p)
    return b.build()


def parts_f(parts: list[str]) -> str:
    b = FnStrBuilder(DEFAULT_CAPACITY)
    for p in parts:
        b = b.append(p)
    return b.build()


def parts_c(parts: list[str], cap: i32) -> str:
    b = ChunkedStrBuilder(cap)
    for p in parts:
        b.append(p)
    return b.build()


def parts_l(parts: list[str]) -> str:
    b = ChunkedListStrBuilder(DEFAULT_CAPACITY)
    for p in parts:
        b.append(p)
    return b.build()


def parts_u(parts: list[str], total: i32) -> str:
    b = UnsafeFixedStrBuilder(total)
    for p in parts:
        b = b.append(p)
    return b.build()


def parts_s(parts: list[str], cap: i32) -> str:
    b = StrBuilder(cap)
    for p in parts:
        b.append(p)
    return b.build()


def parts_su(parts: list[str], total: i32) -> str:
    b = StdUnsafeBuilder(total)
    for p in parts:
        b.append(p)
    return b.build()


def bench_parts(name: str, parts: list[str], reps: i32) -> None:
    total = total_len(parts)
    best_r = 1e18
    best_c = 1e18
    best_ce = 1e18
    best_l = 1e18
    best_f = 1e18
    best_u = 1e18
    best_s = 1e18
    best_se = 1e18
    best_su = 1e18
    for rep in range(reps):
        t0 = time()
        res_r = parts_r(parts)
        t1 = time()
        res_c = parts_c(parts, DEFAULT_CAPACITY)
        t2 = time()
        res_ce = parts_c(parts, total)
        t3 = time()
        res_l = parts_l(parts)
        t4 = time()
        res_f = parts_f(parts)
        t5 = time()
        res_u = parts_u(parts, total)
        t6 = time()
        res_s = parts_s(parts, DEFAULT_CAPACITY)
        t7 = time()
        res_se = parts_s(parts, total)
        t8 = time()
        res_su = parts_su(parts, total)
        t9 = time()
        assert res_c == res_s
        assert res_c == res_se
        assert res_c == res_su
        assert len(res_c) == total
        assert res_c == res_r
        assert res_c == res_ce
        assert res_c == res_l
        assert res_c == res_f
        assert res_c == res_u
        best_r = min(best_r, t1 - t0)
        best_c = min(best_c, t2 - t1)
        best_ce = min(best_ce, t3 - t2)
        best_l = min(best_l, t4 - t3)
        best_f = min(best_f, t5 - t4)
        best_u = min(best_u, t6 - t5)
        best_s = min(best_s, t7 - t6)
        best_se = min(best_se, t8 - t7)
        best_su = min(best_su, t9 - t8)
    row(
        f"{name} ({total} B, {len(parts)} appends)",
        best_r * 1e6,
        best_c * 1e6,
        best_ce * 1e6,
        best_l * 1e6,
        best_f * 1e6,
        best_u * 1e6,
        best_s * 1e6,
        best_se * 1e6,
        best_su * 1e6,
    )


def section_writers() -> None:
    header("2. JSON / CSV writers: one .append per token, us (chunked-exact and unsafe have the exact capacity)")
    bench_parts("json-1KB", make_json_parts(1024), REPS * 200)
    bench_parts("json-64KB", make_json_parts(64 * 1024), REPS * 10)
    bench_parts("json-1MB", make_json_parts(1024 * 1024), REPS)
    bench_parts("csv-1KB", make_csv_parts(1024), REPS * 200)
    bench_parts("csv-64KB", make_csv_parts(64 * 1024), REPS * 10)
    bench_parts("csv-1MB", make_csv_parts(1024 * 1024), REPS)


# ------------------------------------------------------------------ 3. short lists
#
# repr of a list of n ints: "[0, 1, 2, ..., n-1, ]". The int formatting is part
# of the workload, as it is in a real repr; all the builders pay it equally.


def list_r(n: i32) -> str:
    b = ReallocStrBuilder(DEFAULT_CAPACITY)
    b.append("[")
    for i in range(n):
        b.append(f"{i}, ")
    b.append("]")
    return b.build()


def list_f(n: i32) -> str:
    b = FnStrBuilder(DEFAULT_CAPACITY)
    b = b.append("[")
    for i in range(n):
        b = b.append(f"{i}, ")
    b = b.append("]")
    return b.build()


def list_c(n: i32) -> str:
    b = ChunkedStrBuilder(DEFAULT_CAPACITY)
    b.append("[")
    for i in range(n):
        b.append(f"{i}, ")
    b.append("]")
    return b.build()


def list_l(n: i32) -> str:
    b = ChunkedListStrBuilder(DEFAULT_CAPACITY)
    b.append("[")
    for i in range(n):
        b.append(f"{i}, ")
    b.append("]")
    return b.build()


def list_s(n: i32) -> str:
    b = StrBuilder(DEFAULT_CAPACITY)
    b.append("[")
    for i in range(n):
        b.append(f"{i}, ")
    b.append("]")
    return b.build()


def bench_list(n: i32) -> None:
    best_r = 1e18
    best_c = 1e18
    best_l = 1e18
    best_f = 1e18
    best_s = 1e18
    for rep in range(REPS * 100):
        t0 = time()
        res_r = list_r(n)
        t1 = time()
        res_c = list_c(n)
        t2 = time()
        res_l = list_l(n)
        t3 = time()
        res_f = list_f(n)
        t4 = time()
        res_s = list_s(n)
        t5 = time()
        assert res_c == res_s
        assert res_c == res_r
        assert res_c == res_l
        assert res_c == res_f
        best_r = min(best_r, t1 - t0)
        best_c = min(best_c, t2 - t1)
        best_l = min(best_l, t3 - t2)
        best_f = min(best_f, t4 - t3)
        best_s = min(best_s, t5 - t4)
    row(
        f"{n} items",
        best_r * 1e6, best_c * 1e6, -1.0, best_l * 1e6, best_f * 1e6, -1.0,
        best_s * 1e6, -1.0, -1.0,
    )


def section_short() -> None:
    header(f"3. repr of a short list, us, initial capacity {DEFAULT_CAPACITY}")
    bench_list(10)
    bench_list(100)
    bench_list(1000)


# ------------------------------------------------------------------ 4. exact capacity vs estimate
#
# list[int].__repr__ / list[float].__repr__ have two strategies:
#   exact:     a pre-pass computes the exact length: one allocation, no growth.
#   est-low:   an underestimate: the builder has to grow.
#   est-high:  an overestimate: no growth, the slack is dropped by build().
#
# int:   the exact pre-pass counts digits arithmetically (no formatting).
# float: there is no cheap way to know the length without formatting, so the
#        exact pre-pass formats every item once more (2x the formatting work).
# unsafe cannot be used with an underestimate.

EXACT = 0
EST_LOW = 1
EST_HIGH = 2


def ndigits(x: i32) -> i32:
    d = 1
    while x >= 10:
        x //= 10
        d += 1
    return d


def cap_int(mode: i32, n: i32) -> i32:
    if mode == EXACT:
        total = 2
        for i in range(n):
            total += ndigits(ival(i)) + 2
        return total
    elif mode == EST_LOW:
        return n * 2
    else:
        return n * 8


def cap_float(mode: i32, n: i32) -> i32:
    if mode == EXACT:
        total = 2
        for i in range(n):
            total += len(f"{fval(i)}") + 2
        return total
    elif mode == EST_LOW:
        return n * 4
    else:
        return n * 16


def int_s(n: i32, cap: i32) -> str:
    b = StrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{ival(i)}, ")
    b.append("]")
    return b.build()


def int_su(n: i32, cap: i32) -> str:
    b = StdUnsafeBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{ival(i)}, ")
    b.append("]")
    return b.build()


def int_r(n: i32, cap: i32) -> str:
    b = ReallocStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{ival(i)}, ")
    b.append("]")
    return b.build()


def int_f(n: i32, cap: i32) -> str:
    b = FnStrBuilder(cap)
    b = b.append("[")
    for i in range(n):
        b = b.append(f"{ival(i)}, ")
    b = b.append("]")
    return b.build()


def int_c(n: i32, cap: i32) -> str:
    b = ChunkedStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{ival(i)}, ")
    b.append("]")
    return b.build()


def int_l(n: i32, cap: i32) -> str:
    b = ChunkedListStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{ival(i)}, ")
    b.append("]")
    return b.build()


def int_u(n: i32, cap: i32) -> str:
    b = UnsafeFixedStrBuilder(cap)
    b = b.append("[")
    for i in range(n):
        b = b.append(f"{ival(i)}, ")
    b = b.append("]")
    return b.build()


def float_s(n: i32, cap: i32) -> str:
    b = StrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{fval(i)}, ")
    b.append("]")
    return b.build()


def float_su(n: i32, cap: i32) -> str:
    b = StdUnsafeBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{fval(i)}, ")
    b.append("]")
    return b.build()


def float_r(n: i32, cap: i32) -> str:
    b = ReallocStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{fval(i)}, ")
    b.append("]")
    return b.build()


def float_f(n: i32, cap: i32) -> str:
    b = FnStrBuilder(cap)
    b = b.append("[")
    for i in range(n):
        b = b.append(f"{fval(i)}, ")
    b = b.append("]")
    return b.build()


def float_c(n: i32, cap: i32) -> str:
    b = ChunkedStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{fval(i)}, ")
    b.append("]")
    return b.build()


def float_l(n: i32, cap: i32) -> str:
    b = ChunkedListStrBuilder(cap)
    b.append("[")
    for i in range(n):
        b.append(f"{fval(i)}, ")
    b.append("]")
    return b.build()


def float_u(n: i32, cap: i32) -> str:
    b = UnsafeFixedStrBuilder(cap)
    b = b.append("[")
    for i in range(n):
        b = b.append(f"{fval(i)}, ")
    b = b.append("]")
    return b.build()


def mode_name(mode: i32) -> str:
    if mode == EXACT:
        return "exact   "
    elif mode == EST_LOW:
        return "est-low "
    else:
        return "est-high"


def bench_int(mode: i32, n: i32, expected: str) -> None:
    best_r = 1e18
    best_c = 1e18
    best_l = 1e18
    best_f = 1e18
    best_u = 1e18
    best_s = 1e18
    best_su = 1e18
    for rep in range(REPS * 20):
        t0 = time()
        res_r = int_r(n, cap_int(mode, n))
        t1 = time()
        res_c = int_c(n, cap_int(mode, n))
        t2 = time()
        res_l = int_l(n, cap_int(mode, n))
        t3 = time()
        res_f = int_f(n, cap_int(mode, n))
        t4 = time()
        res_s = int_s(n, cap_int(mode, n))
        t4s = time()
        assert res_s == expected
        assert res_r == expected
        assert res_c == expected
        assert res_l == expected
        assert res_f == expected
        best_r = min(best_r, t1 - t0)
        best_c = min(best_c, t2 - t1)
        best_l = min(best_l, t3 - t2)
        best_f = min(best_f, t4 - t3)
        best_s = min(best_s, t4s - t4)
        if mode != EST_LOW:
            t5 = time()
            res_u = int_u(n, cap_int(mode, n))
            t6 = time()
            assert res_u == expected
            best_u = min(best_u, t6 - t5)
            res_su = int_su(n, cap_int(mode, n))
            t7 = time()
            assert res_su == expected
            best_su = min(best_su, t7 - t6)
    u = -1.0
    su = -1.0
    if mode != EST_LOW:
        u = best_u * 1e6
        su = best_su * 1e6
    row(
        f"int   n={n} {mode_name(mode)}",
        best_r * 1e6, best_c * 1e6, -1.0, best_l * 1e6, best_f * 1e6, u,
        best_s * 1e6, -1.0, su,
    )


def bench_float(mode: i32, n: i32, expected: str) -> None:
    best_r = 1e18
    best_c = 1e18
    best_l = 1e18
    best_f = 1e18
    best_u = 1e18
    best_s = 1e18
    best_su = 1e18
    for rep in range(REPS * 20):
        t0 = time()
        res_r = float_r(n, cap_float(mode, n))
        t1 = time()
        res_c = float_c(n, cap_float(mode, n))
        t2 = time()
        res_l = float_l(n, cap_float(mode, n))
        t3 = time()
        res_f = float_f(n, cap_float(mode, n))
        t4 = time()
        res_s = float_s(n, cap_float(mode, n))
        t4s = time()
        assert res_s == expected
        assert res_r == expected
        assert res_c == expected
        assert res_l == expected
        assert res_f == expected
        best_r = min(best_r, t1 - t0)
        best_c = min(best_c, t2 - t1)
        best_l = min(best_l, t3 - t2)
        best_f = min(best_f, t4 - t3)
        best_s = min(best_s, t4s - t4)
        if mode != EST_LOW:
            t5 = time()
            res_u = float_u(n, cap_float(mode, n))
            t6 = time()
            assert res_u == expected
            best_u = min(best_u, t6 - t5)
            res_su = float_su(n, cap_float(mode, n))
            t7 = time()
            assert res_su == expected
            best_su = min(best_su, t7 - t6)
    u = -1.0
    su = -1.0
    if mode != EST_LOW:
        u = best_u * 1e6
        su = best_su * 1e6
    row(
        f"float n={n} {mode_name(mode)}",
        best_r * 1e6, best_c * 1e6, -1.0, best_l * 1e6, best_f * 1e6, u,
        best_s * 1e6, -1.0, su,
    )


def section_exact() -> None:
    header("4. repr of list[int] / list[float], us: exact capacity vs estimate")
    for n in [100, 1000]:
        expected_i = int_c(n, cap_int(EXACT, n))
        expected_f = float_c(n, cap_float(EXACT, n))
        for mode in range(3):
            bench_int(mode, n, expected_i)
        for mode in range(3):
            bench_float(mode, n, expected_f)


def main() -> None:
    section_append_size()
    section_writers()
    section_short()
    section_exact()
