"""
Benchmarks comparing scalar (non-SIMD) and SIMD implementations of a few
simple elementwise / reduction kernels.

Build & run with different SIMD widths, e.g.:

```sh
spy build -x --release --simd-width 16 bench_simd.spy  # default
spy build -x --release --simd-width 32 bench_simd.spy
spy build -x --release --simd-width 64 bench_simd.spy
```
"""

from time import time
from simd import SIMD, simd_width_of, ptr_load_simd, ptr_store_simd
from unsafe import gc_alloc, gc_ptr


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------


def fill[T](arr: gc_ptr[T], n: i32, start: T, step: T) -> None:
    v = start
    for i in range(n):
        arr[i] = v
        v = v + step


def approx_eq[T](a: T, b: T, tol: T) -> bool:
    d = a - b
    if d < 0.0:
        d = -d
    ok = d < tol
    return ok


# ---------------------------------------------------------------------------
# SAXPY:  out = a * x + y
# ---------------------------------------------------------------------------


def saxpy_scalar[T](a: T, x: gc_ptr[T], y: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    for i in range(n):
        out[i] = a * x[i] + y[i]


def saxpy_simd[T](a: T, x: gc_ptr[T], y: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    W = simd_width_of[T]
    va = SIMD[T, W](a)
    bound: i32 = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        vy = ptr_load_simd[T, W](y, i)
        ptr_store_simd(out, i, va * vx + vy)
    for j in range(bound, n):
        out[j] = a * x[j] + y[j]


# ---------------------------------------------------------------------------
# Masked elementwise:  ReLU  (max(x, 0))
# ---------------------------------------------------------------------------


def relu_scalar[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    for i in range(n):
        v = x[i]
        if v > 0.0:
            out[i] = v
        else:
            out[i] = 0.0


def relu_simd[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    W = simd_width_of[T]
    zero = SIMD[T, W](0.0)
    bound: i32 = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        mask = vx > zero
        ptr_store_simd(out, i, mask.select(vx, zero))
    for j in range(bound, n):
        v = x[j]
        if v > 0.0:
            out[j] = v
        else:
            out[j] = 0.0


# ---------------------------------------------------------------------------
# Reduction:  dot product  (sum(x * y))
# ---------------------------------------------------------------------------


def dot_scalar[T](x: gc_ptr[T], y: gc_ptr[T], n: i32) -> T:
    total: T = 0.0
    for i in range(n):
        total = total + x[i] * y[i]
    return total


def dot_simd[T](x: gc_ptr[T], y: gc_ptr[T], n: i32) -> T:
    W = simd_width_of[T]
    acc = SIMD[T, W](0.0)
    bound = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        vy = ptr_load_simd[T, W](y, i)
        acc = acc + vx * vy
    # total: T = acc.reduce_add()
    total: T = 0
    for idx in range(W):
        total += acc[idx]
    for j in range(bound, n):
        total = total + x[j] * y[j]
    return total


def main() -> None:
    N: i32 = 1 << 20  # ~1M elements
    REPEAT = 50

    dtype = f32

    a: dtype = 2.0
    x = gc_alloc[dtype](N)
    y = gc_alloc[dtype](N)
    out = gc_alloc[dtype](N)

    fill[dtype](x, N, 1.0, 0.0001)
    fill[dtype](y, N, 0.5, -0.0001)

    W = simd_width_of[dtype]
    print("dtype    =", dtype)
    print("N        =", N)
    print("repeat   =", REPEAT)
    print("simd W   =", W)
    print("N // W   =", N // W)
    print()

    # --- SAXPY ---
    t0 = time()
    for _ in range(REPEAT):
        saxpy_scalar[dtype](a, x, y, out, N)
    ts = time() - t0

    t0 = time()
    for _0 in range(REPEAT):
        saxpy_simd[dtype](a, x, y, out, N)
    tv = time() - t0

    saxpy_scalar[dtype](a, x, y, out, N)
    ref = out[N // 2]
    saxpy_simd[dtype](a, x, y, out, N)
    got = out[N // 2]
    print(
        "SAXPY   scalar=",
        ts,
        "s  simd=",
        tv,
        "s  speedup=",
        ts / tv,
        "x  ok=",
        approx_eq[dtype](ref, got, 1e-4),
    )

    # --- ReLU ---
    t0 = time()
    for _1 in range(REPEAT):
        relu_scalar[dtype](x, out, N)
    ts = time() - t0

    t0 = time()
    for _2 in range(REPEAT):
        relu_simd[dtype](x, out, N)
    tv = time() - t0

    relu_scalar[dtype](x, out, N)
    ref = out[N // 2]
    relu_simd[dtype](x, out, N)
    got = out[N // 2]
    ok = approx_eq[dtype](ref, got, 1e-4)
    print("ReLU    scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)

    # --- Dot product ---
    # to avoid dead-code elimination
    sink = gc_alloc[dtype](2)

    t0 = time()
    for _3 in range(REPEAT):
        sink[0] += dot_scalar[dtype](x, y, N)
    ts = time() - t0

    t0 = time()
    for _4 in range(REPEAT):
        sink[1] += dot_simd[dtype](x, y, N)
    tv = time() - t0

    ref = dot_scalar[dtype](x, y, N)
    got = dot_simd[dtype](x, y, N)
    ok = approx_eq[dtype](ref, got, 1e-2)
    print("Dot     scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)
