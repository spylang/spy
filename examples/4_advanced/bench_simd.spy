"""
Benchmarks comparing scalar (non-SIMD) and SIMD implementations of a few
simple elementwise / reduction kernels.

Build & run with different SIMD widths, e.g.:

```sh
spy build -x --release --march=native --simd-width 16 bench_simd.spy  # default
spy build -x --release --march=native --simd-width 32 bench_simd.spy
spy build -x --release --march=native --simd-width 64 bench_simd.spy
```
"""

from math import exp
from time import time
from simd import SIMD, simd_width_of, ptr_load_simd, ptr_store_simd
from unsafe import gc_alloc, gc_ptr


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------


def fill[T](arr: gc_ptr[T], n: i32, start: T, step: T) -> None:
    v = start
    for i in range(n):
        arr[i] = v
        v = v + step


def approx_eq[T](a: T, b: T, rel_tol: T) -> bool:
    d = abs(a - b)
    ok = d / abs(a) < rel_tol
    return ok


# ---------------------------------------------------------------------------
# SAXPY:  out = a * x + y
# ---------------------------------------------------------------------------


def saxpy_scalar[T](a: T, x: gc_ptr[T], y: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    for i in range(n):
        out[i] = a * x[i] + y[i]


def saxpy_simd[T](a: T, x: gc_ptr[T], y: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    W = simd_width_of[T]
    va = SIMD[T, W](a)
    bound: i32 = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        vy = ptr_load_simd[T, W](y, i)
        ptr_store_simd(out, i, va * vx + vy)
    for j in range(bound, n):
        out[j] = a * x[j] + y[j]


# ---------------------------------------------------------------------------
# Masked elementwise:  ReLU  (max(x, 0))
# ---------------------------------------------------------------------------


def relu_scalar[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    for i in range(n):
        v = x[i]
        if v > 0.0:
            out[i] = v
        else:
            out[i] = 0.0


def relu_simd[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    W = simd_width_of[T]
    zero = SIMD[T, W](0.0)
    bound: i32 = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        mask = vx > zero
        ptr_store_simd(out, i, mask.select(vx, zero))
    for j in range(bound, n):
        v = x[j]
        if v > 0.0:
            out[j] = v
        else:
            out[j] = 0.0


# ---------------------------------------------------------------------------
# Reduction:  dot product  (sum(x * y))
# ---------------------------------------------------------------------------


def dot_scalar[T](x: gc_ptr[T], y: gc_ptr[T], n: i32) -> T:
    total: T = 0.0
    for i in range(n):
        total = total + x[i] * y[i]
    return total


def dot_simd[T](x: gc_ptr[T], y: gc_ptr[T], n: i32) -> T:
    W = simd_width_of[T]
    acc = SIMD[T, W](0.0)
    bound = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        vy = ptr_load_simd[T, W](y, i)
        acc = acc + vx * vy
    # total: T = acc.reduce_add()
    total: T = 0
    for idx in range(W):
        total += acc[idx]
    for j in range(bound, n):
        total = total + x[j] * y[j]
    return total


# -----------------------------------------
# Reduction:  sum of squares  (sum(x * x))
# -----------------------------------------


def squares_scalar[T](x: gc_ptr[T], n: i32) -> T:
    total: T = 0.0
    for i in range(n):
        total = total + x[i] * x[i]
    return total


def squares_simd[T](x: gc_ptr[T], n: i32) -> T:
    W = simd_width_of[T]
    acc = SIMD[T, W](0.0)
    bound = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)
        acc = acc + vx * vx
    # total: T = acc.reduce_add()
    total: T = 0
    for idx in range(W):
        total += acc[idx]
    for j in range(bound, n):
        total = total + x[j] * x[j]
    return total


# -------------------------------------------------------------
# Elementwise:  exp(x)  — opaque scalar call vs SIMD polynomial
# -------------------------------------------------------------
#
# Demonstrates the other classic case autovectorization cannot touch: an
# opaque function call in the loop body.  The scalar loop calls the real
# (non-inlined) libm exp on every element, so the compiler cannot vectorize
# across the call regardless of how simple the body looks.  The SIMD path
# replaces it with a pure +/-/* polynomial on SIMD lanes, which vectorizes
# fully.  This is exactly why vectorized math libraries (SVML, SLEEF) exist.
#
# SPy's SIMD subset is currently limited (no trunc/floor/reinterpret_as, no
# argument reduction, no 2^k scaling), so we keep the input in [-0.5, 0.5]
# where a 6th-degree polynomial for exp is accurate to < 1e-7 directly.


# exp(x) Taylor/minimax polynomial, degree 6, accurate to ~6e-9 on [-0.5, 0.5].
EXP_P0 = 1.0
EXP_P1 = 1.0
EXP_P2 = 0.5
EXP_P3 = 0.166666667
EXP_P4 = 0.0416666667
EXP_P5 = 0.00833333333
EXP_P6 = 0.00138888889


# Scalar reference: calls the real (non-inlined) libm exp on every element.
# The compiler cannot see through the external call, so this loop does NOT
# autovectorize regardless of how simple it looks.
def exp_scalar[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    for i in range(n):
        out[i] = exp(x[i])


# SIMD path: a 6th-degree Horner polynomial for exp, evaluated with only + and *
# on SIMD lanes, so the whole loop body vectorizes.
def exp_simd[T](x: gc_ptr[T], out: gc_ptr[T], n: i32) -> None:
    W = simd_width_of[T]
    p0 = SIMD[T, W](EXP_P0)
    p1 = SIMD[T, W](EXP_P1)
    p2 = SIMD[T, W](EXP_P2)
    p3 = SIMD[T, W](EXP_P3)
    p4 = SIMD[T, W](EXP_P4)
    p5 = SIMD[T, W](EXP_P5)
    p6 = SIMD[T, W](EXP_P6)

    bound: i32 = n - (n % W)
    for i in range(0, bound, W):
        vx = ptr_load_simd[T, W](x, i)

        # Horner: p6*x + p5, ... , *x + p0
        pr = p6
        pr = pr * vx + p5
        pr = pr * vx + p4
        pr = pr * vx + p3
        pr = pr * vx + p2
        pr = pr * vx + p1
        pr = pr * vx + p0

        ptr_store_simd(out, i, pr)

    # scalar tail for the remainder (uses the real exp, like the scalar path)
    for j in range(bound, n):
        out[j] = exp(x[j])


def main() -> None:
    N: i32 = 1 << 20  # ~1M elements
    REPEAT = 200

    dtype = f64

    a: dtype = 2.0
    x = gc_alloc[dtype](N)
    y = gc_alloc[dtype](N)
    out = gc_alloc[dtype](N)

    fill[dtype](x, N, 1.0, 0.0001)
    fill[dtype](y, N, 0.5, -0.0001)

    W = simd_width_of[dtype]
    print("dtype    =", dtype)
    print("N        =", N)
    print("repeat   =", REPEAT)
    print("simd W   =", W)
    print("N // W   =", N // W)
    print()

    # --- SAXPY ---
    t0 = time()
    for _ in range(REPEAT):
        saxpy_scalar[dtype](a, x, y, out, N)
    ts = time() - t0

    t0 = time()
    for _0 in range(REPEAT):
        saxpy_simd[dtype](a, x, y, out, N)
    tv = time() - t0

    saxpy_scalar[dtype](a, x, y, out, N)
    ref = out[N // 2]
    saxpy_simd[dtype](a, x, y, out, N)
    got = out[N // 2]
    print(
        "SAXPY   scalar=",
        ts,
        "s  simd=",
        tv,
        "s  speedup=",
        ts / tv,
        "x  ok=",
        approx_eq[dtype](ref, got, 1e-4),
    )

    # --- ReLU ---
    t0 = time()
    for _1 in range(REPEAT):
        relu_scalar[dtype](x, out, N)
    ts = time() - t0

    t0 = time()
    for _2 in range(REPEAT):
        relu_simd[dtype](x, out, N)
    tv = time() - t0

    relu_scalar[dtype](x, out, N)
    ref = out[N // 2]
    relu_simd[dtype](x, out, N)
    got = out[N // 2]
    ok = approx_eq[dtype](ref, got, 1e-4)
    print("ReLU    scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)

    # --- Dot product ---
    # to avoid dead-code elimination
    sink = gc_alloc[dtype](2)

    t0 = time()
    for _3 in range(REPEAT):
        sink[0] += dot_scalar[dtype](x, y, N)
    ts = time() - t0

    t0 = time()
    for _4 in range(REPEAT):
        sink[1] += dot_simd[dtype](x, y, N)
    tv = time() - t0

    ref = dot_scalar[dtype](x, y, N)
    got = dot_simd[dtype](x, y, N)
    ok = approx_eq[dtype](ref, got, 1e-4)
    print("Dot     scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)

    # --- Sum of squares ---
    t0 = time()
    for _5 in range(REPEAT):
        sink[0] += squares_scalar[dtype](x, N)
    ts = time() - t0

    t0 = time()
    for _6 in range(REPEAT):
        sink[1] += squares_simd[dtype](x, N)
    tv = time() - t0

    ref = squares_scalar[dtype](x, N)
    got = squares_simd[dtype](x, N)
    ok = approx_eq[dtype](ref, got, 1e-4)
    print("Squares scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)

    # --- Elementwise exp: opaque scalar call vs SIMD polynomial ---
    # Narrow input range [-0.5, 0.5] where a degree-6 exp polynomial is
    # accurate to < 1e-7, so no argument reduction / 2^k scaling is needed.
    exp_in = gc_alloc[dtype](N)
    fill[dtype](exp_in, N, -0.5, 1.0 / N)

    t0 = time()
    for _7 in range(REPEAT):
        exp_scalar[dtype](exp_in, out, N)
    ts = time() - t0

    t0 = time()
    for _8 in range(REPEAT):
        exp_simd[dtype](exp_in, out, N)
    tv = time() - t0

    exp_scalar[dtype](exp_in, out, N)
    ref = out[N // 2]
    exp_simd[dtype](exp_in, out, N)
    got = out[N // 2]
    ok = approx_eq[dtype](ref, got, 1e-5)
    print("Exp     scalar=", ts, "s  simd=", tv, "s  speedup=", ts / tv, "x  ok=", ok)
