@blue
def specialize(val):
    """
    Shortcut for `Specialized[val]()`.
    `Specialized[val]` is a singleton type with exactly one instance,

    Generic types such as `tuple` can use it to treat an item as a blue constant instead
    of storing it.
    """
    return Specialized[val]()


@struct
class Specialized[VAL]:
    val = VAL

    def __repr__(self) -> str:
        return "specialize(" + repr(VAL) + ")"
