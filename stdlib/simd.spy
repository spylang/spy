from _simd import SIMD
from operator import OpSpec
from unsafe import ptr_to_addr, sizeof


@blue.metafunc
def align_offset(m_ptr, m_N, m_n):
    """
    align_offset(ptr, N, n) -> i32

    Return how many elements of `ptr`'s item type must be skipped so that
    `ptr + offset` is aligned to N bytes, clamped to `n`.  N must be a
    power of two.

    Meant for a scalar "peeling" loop that walks forward `offset` elements
    before switching to a fast N-aligned path (e.g. SIMD) on a buffer
    whose alignment isn't provable statically.
    """
    PTR = m_ptr.static_type
    itemsize: i32 = sizeof(PTR.itemtype)

    def impl(ptr: PTR, N: i32, n: i32) -> i32:
        assert N > 0 and (N & (N - 1)) == 0  # N must be a power of two
        addr: i32 = ptr_to_addr(ptr)
        offset_bytes: i32 = (-addr) & (N - 1)
        offset: i32 = offset_bytes // itemsize
        if offset > n:
            return n
        return offset

    return OpSpec(impl)


@blue.generic
def from_list(T, N, L):
    """
    Implementation of `v: SIMD[T, N] = [a, b, ...]`, where `L` is the type of
    the list.
    """

    # exception messages must be blue, so we build it here and not in impl
    # (so it cannot contain len(items))
    msg = "SIMD: expected " + str(N) + " elements in the list"

    def impl(items: L) -> SIMD[T, N]:
        if len(items) != N:
            raise ValueError(msg)
        v = SIMD[T, N].zeros()
        for i in range(N):
            v = v._with_lane(i, items[i])
        return v

    return impl


@blue.generic
def from_tuple(T, N, TUP):
    """
    Implementation of `v: SIMD[T, N] = (a, b, ...)`, where `TUP` is the type of
    the tuple.
    """

    # tuple indices must be blue, so `build` unrolls the loop at compile time
    # by recursion (same technique as in _tuple.spy)
    @blue
    def build(idx):
        if idx == N:

            def done(v: SIMD[T, N], t: TUP) -> SIMD[T, N]:
                return v

            return done

        rest = build(idx + 1)

        def step(v: SIMD[T, N], t: TUP) -> SIMD[T, N]:
            return rest(v._with_lane(idx, t[idx]), t)

        return step

    fill = build(0)

    def impl(t: TUP) -> SIMD[T, N]:
        return fill(SIMD[T, N].zeros(), t)

    return impl
