from operator import OpSpec, MetaArg
from __spy__ import force_inline, interp_tuple, lookup_fqn, Specialized


@blue
def is_specialized_type(T):
    return T.__origin__ is Specialized


@blue.generic
def tuple(*items_T):
    if type in items_T:
        # `type` cannot be put in a struct, so we need to use interp_tuple for now
        return interp_tuple

    N = len(items_T)

    @blue
    def get_fields():
        """
        Return a dict like {
            "_item0": int,
            "_item1": int,
        }
        """
        fields: dict[str, type] = {}
        for i in unroll(range(N)):
            if is_specialized_type(items_T[i]):
                # `specialize(X)` fields are blue consts, they don't need any storage
                pass
            else:
                fname = "_item" + str(i)
                fields[fname] = items_T[i]
        return fields

    @blue
    def make_specialized_err_msg(i):
        # this is a hack: in theory we should be able to use this line directly inside
        # __new__, but f-strings are always for now.
        return f"tuple item {i} does not match the specialized value"

    @blue
    def has_specialized_items():
        for i in unroll(range(N)):
            if is_specialized_type(items_T[i]):
                return True
        return False

    @struct
    class _tup:
        __extra_fields__ = get_fields()

        # see SPyVM.is_specialized_tuple_type
        __is_specialized_type__ = has_specialized_items()

        @blue.metafunc
        def __len__(m_self):
            return OpSpec.const(N)

        @blue.metafunc
        def __new__(m_cls, *args_m):
            new_args_m: list[MetaArg] = []
            for i in unroll(range(N)):
                T = items_T[i]
                m_arg = args_m[i]
                if is_specialized_type(T):
                    # a specialized item doesn't take any storage, drop it
                    if not T.matches(m_arg):
                        raise TypeError(make_specialized_err_msg(i))
                else:
                    new_args_m.append(m_arg)
            return OpSpec(_tup.__make__, new_args_m)

        @blue.metafunc
        def __getitem__(m_self, m_i):
            if m_i.color != "blue":
                raise TypeError("tuple index must be blue")

            # idx is blue so all the following lines are pre-evaluated at compile time
            i = m_i.blueval
            T = items_T[i]
            if is_specialized_type(T):
                return OpSpec.const(T.val)

            attr = "_item" + str(i)

            def get(self: _tup) -> T:
                # attr is blue, so this is equivalent to e.g. `self.item0`
                return getattr(self, attr)

            return OpSpec(get, [m_self])

        @blue.metafunc
        def __contains__(m_self, m_v):
            """
            Implement the 'in' operator only on homogeneous tuples.
            """
            T = m_v.static_type

            @blue
            def is_homogeneous():
                for U in items_T:
                    if U != items_T[0]:
                        return False
                return True

            if not is_homogeneous():
                raise TypeError("'in' is not supported on heterogeneous tuples")

            # `unroll` expands the loop, so e.g. for tuple[i32, i32, i32] the
            # expression `v in t` compiles to code equivalent to:
            #     t._item0 == v or t._item1 == v or t._item2 == v
            def contains(self: _tup, v: T) -> bool:
                for i in unroll(range(N)):
                    if self[i] == v:
                        return True
                return False

            return OpSpec(contains, [m_self, m_v])

        def __repr__(self) -> str:
            # we don't support circular imports and function-level imports. This is a
            # hacky workaround for 'from _strbuilder import StrBuilder'
            StrBuilder = lookup_fqn("strbuilder::StrBuilder")
            sb = StrBuilder(N * 4 + 2)
            sb.append("(")
            for i in unroll(range(N)):
                item = self[i]
                sb.append(repr(item))
                if N == 1:
                    # this is needed for single-item tuples: we want to emit
                    # e.g. `(1,)`, not `(1)`
                    sb.append(",")
                elif i != N - 1:
                    # this is to avoid putting a `,` after the last element
                    sb.append(", ")
            sb.append(")")
            return sb.build()

        def __str__(self) -> str:
            return repr(self)

    return _tup
