from _str import StrObject
from unsafe import gc_alloc, gc_ptr, ptr_copy_slice, ptr_setbytes_slice


@struct
class Chunk:
    prev: gc_ptr[Chunk]
    buf: gc_ptr[StrObject]
    pos: i32  # bytes used in buf


@struct
class StrBuilder:
    """
    Build a string piece by piece, growing as needed.

        sb = StrBuilder(initial_capacity)
        sb.append("hello ")
        sb.append("world")
        s = sb.build()

    `initial_capacity` is the size in bytes of the first chunk.
    """

    __ll__: gc_ptr[Chunk]

    def __new__(initial_capacity: i32) -> StrBuilder:
        if initial_capacity < 0:
            raise ValueError("StrBuilder capacity must not be negative")

        chunk = gc_alloc[Chunk](1)
        chunk.prev = gc_ptr[Chunk].NULL
        chunk.buf = StrObject.alloc(initial_capacity)
        chunk.pos = 0
        return StrBuilder.__make__(chunk)

    def append(self, s: str) -> None:
        chunk = self.__ll__
        if chunk.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        lls = StrObject.from_str(s)
        n = lls.length
        assert chunk.pos + n <= chunk.buf.length, "TODO: implement growth"
        ptr_copy_slice(chunk.buf.utf8, chunk.pos, chunk.pos + n, lls.utf8, 0, n)
        chunk.pos += n

    def build(self) -> str:
        """
        Return the string and seal the builder.
        """
        chunk = self.__ll__
        if chunk.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")

        assert chunk.prev == gc_ptr[Chunk].NULL, "TODO: implement multi-chunk"
        if chunk.pos < chunk.buf.length:
            # underfill: we didn't use all the space in buf. Let's just pretend the
            # StrObject is shorter. This leaks a bit of memory at the end, too bad.
            chunk.buf.length = chunk.pos

        # "steal" chunk.buf and turn it into a user-visible str
        buf = chunk.buf
        chunk.buf = gc_ptr[StrObject].NULL
        return StrObject.to_str(buf)


# ========== UnsafeFixedStrBuilder ==========


@struct
class UnsafeBuilderState:
    buffer: gc_ptr[StrObject]
    position: i32


@struct
class UnsafeFixedStrBuilder:
    """
    Build a string in a fixed-size buffer, with capacity measured in bytes.

    This class is UNSAFE. No check is performed. It is up to the caller to ensure that
    the appended chunks fit in the capacity. If the final string is shorter than the
    capacity, build() just adjusts the length and the remaining bytes stay unused.

    The main consumer is str.join(list[str]), which needs to be fast and where you can
    easily precompute the exact capacity.  For a more general and safer way to build a
    string whose length is not known, use StrBuilder.
    """

    __ll__: gc_ptr[UnsafeBuilderState]

    def __new__(capacity: i32) -> UnsafeFixedStrBuilder:
        state = gc_alloc[UnsafeBuilderState](1)
        state.buffer = StrObject.alloc(capacity)
        state.position = 0
        return UnsafeFixedStrBuilder.__make__(state)

    def append(self, chunk: str) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        length = source.length
        if length > 0:
            ptr_copy_slice(
                state.buffer.utf8,
                state.position,
                state.position + length,
                source.utf8,
                0,
                length,
            )
            state.position = state.position + length

    def append_repeat(self, chunk: str, n: i32) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        total = source.length * n
        l = source.length
        if l == 1:
            # single-byte chunk (e.g. a fill char): use memset instead of n copies
            ptr_setbytes_slice(
                state.buffer.utf8,
                state.position,
                state.position + n,
                source.utf8[0],
            )
        else:
            for i in range(n):
                ptr_copy_slice(
                    state.buffer.utf8,
                    state.position + i * l,
                    state.position + (i + 1) * l,
                    source.utf8,
                    0,
                    l,
                )
        state.position = state.position + total

    def append_slice(self, chunk: str, start: i32, end: i32) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        length = end - start
        if length > 0:
            ptr_copy_slice(
                state.buffer.utf8,
                state.position,
                state.position + length,
                source.utf8,
                start,
                end,
            )
            state.position = state.position + length

    def build(self) -> str:
        state = self.__ll__
        state.buffer.length = state.position
        return StrObject.to_sealed_str(state.buffer)
