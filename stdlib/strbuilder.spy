from _str import StrObject
from unsafe import gc_alloc, gc_ptr, ptr_copy_slice, ptr_setbytes_slice

# A StrBuilder is a linked list of Chunks, newest first. The head is the Chunk being
# filled; older sealed Chunks are reached via .prev. Graphically, for a builder that
# contains "hello world!" split across three chunks:
#
#   StrBuilder.__ll__
#       ↓
#   [buf="!...",   pos=1, prev_length=11] unsealed, "..." are to be filled
#       ↓
#   [buf="world",  pos=5, prev_length=6 ] sealed
#       ↓
#   [buf="hello ", pos=6, prev_length=0 ] sealed
#       ↓
#      NULL
#
# The invariants are:
#   1. the head contains an *unsealed* StrObject
#   2. all the .prevs contain *sealed* StrObjects which cannot be modified.
#   3. prev_length contains the total length of ALL the prev chunks
#
# On .append(), we fill the head buffer. When the buffer is full, we seal it and
# allocate a new one, with a certain growth factor to keep number of reallocations
# small.
#
# .build() creates the final string; we support two different cases:
#
#   1. one chunk: we seal and return that StrObject. The unused capacity is kept alive,
#      so be careful with that. Allocating an initial capacity which is too big might
#      result into unwanted memory consumption.
#
#   2. if we have multiple chunks, we allocate a fresh StrObject of the right size
#      and fill it
#
# The best case scenario is when we give an exact capacity and we fill it completely. In
# this case, we do only two allocations in total (one for the head chunk and one for the
# StrBuilder) and we copy each byte only once, to fill the buffer.
#
# There is also UnsafeFixedStrBuilder: this is only if you know in advance the exact
# capacity, doesn't support growing and doesn't do any bound check. The typical use case
# is something like `str.join(list[str])`.


@struct
class Chunk:
    buf: gc_ptr[StrObject]
    pos: i32  # bytes used in buf
    prev: gc_ptr[Chunk]
    prev_length: i32  # total bytes stored in the `prev` chain


@struct
class UnsafeFixedStrBuilder:
    """
    Build a string in a fixed-size buf, with capacity measured in bytes.

    This class is UNSAFE. No check is performed. It is up to the caller to ensure that
    the appended chunks fit in the capacity. If the final string is shorter than the
    capacity, build() just adjusts the length and the remaining bytes stay unused.

    The main consumer is str.join(list[str]), which needs to be fast and where you can
    easily precompute the exact capacity.  For a more general and safer way to build a
    string whose length is not known, use StrBuilder.
    """

    __ll__: gc_ptr[Chunk]

    def __new__(capacity: i32) -> UnsafeFixedStrBuilder:
        head = gc_alloc[Chunk](1)
        head.buf = StrObject.alloc(capacity)
        head.pos = 0
        head.prev = gc_ptr[Chunk].NULL
        head.prev_length = 0
        return UnsafeFixedStrBuilder.__make__(head)

    def append(self, chunk: str) -> None:
        head = self.__ll__
        src = StrObject.from_str(chunk)
        n = src.length
        if n > 0:
            ptr_copy_slice(
                head.buf.utf8,
                head.pos,
                head.pos + n,
                src.utf8,
                0,
                n,
            )
            head.pos = head.pos + n

    def append_repeat(self, chunk: str, n: i32) -> None:
        head = self.__ll__
        source = StrObject.from_str(chunk)
        total = source.length * n
        l = source.length
        if l == 1:
            # single-byte chunk (e.g. a fill char): use memset instead of n copies
            ptr_setbytes_slice(
                head.buf.utf8,
                head.pos,
                head.pos + n,
                source.utf8[0],
            )
        else:
            for i in range(n):
                ptr_copy_slice(
                    head.buf.utf8,
                    head.pos + i * l,
                    head.pos + (i + 1) * l,
                    source.utf8,
                    0,
                    l,
                )
        head.pos = head.pos + total

    def append_slice(self, chunk: str, start: i32, end: i32) -> None:
        head = self.__ll__
        source = StrObject.from_str(chunk)
        length = end - start
        if length > 0:
            ptr_copy_slice(
                head.buf.utf8,
                head.pos,
                head.pos + length,
                source.utf8,
                start,
                end,
            )
            head.pos = head.pos + length

    def build(self) -> str:
        head = self.__ll__
        head.buf.length = head.pos
        return StrObject.to_sealed_str(head.buf)


@struct
class StrBuilder:
    """
    Build a string piece by piece, growing as needed.

        sb = StrBuilder(initial_capacity)
        sb.append("hello ")
        sb.append("world")
        s = sb.build()

    `initial_capacity` is the size in bytes of the first chunk.
    """

    unsafe_sb: UnsafeFixedStrBuilder

    def __new__(initial_capacity: i32) -> StrBuilder:
        if initial_capacity < 0:
            raise ValueError("StrBuilder capacity must not be negative")
        return StrBuilder.__make__(UnsafeFixedStrBuilder(initial_capacity))

    def append(self, s: str) -> None:
        head = self.unsafe_sb.__ll__
        if head.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        n = StrObject.from_str(s).length
        room = head.buf.length - head.pos
        if n <= room:
            # fast path: we can copy into the current chunk
            self.unsafe_sb.append(s)
            return

        # slow path: fill the current buf, then grow and copy the rest
        self.unsafe_sb.append_slice(s, 0, room)
        self._grow(n - room)
        self.unsafe_sb.append_slice(s, room, n)

    def _grow(self, needed: i32) -> None:
        """
        The current buffer is full: seal it into the chain and allocate a bigger one.
        """
        head = self.unsafe_sb.__ll__

        # move the existing buffer into a sealed chunk, and link it to the head
        sealed = gc_alloc[Chunk](1)
        sealed.buf = head.buf
        sealed.pos = head.pos
        sealed.prev = head.prev
        sealed.prev_length = head.prev_length

        head.prev = sealed
        head.prev_length += head.pos

        # allocate a new buffer for the head
        new_capacity = head.buf.length * 2
        if new_capacity < needed:
            new_capacity = needed
        head.buf = StrObject.alloc(new_capacity)
        head.pos = 0

    def build(self) -> str:
        """
        Return the string and seal the builder.
        """
        head = self.unsafe_sb.__ll__
        if head.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")

        if head.prev == gc_ptr[Chunk].NULL:
            # we have a single chunk, just seal&steal the StrObject.
            # If it is underfilled, build() shrinks it and leaks a bit of memory.
            res = self.unsafe_sb.build()
            head.buf = gc_ptr[StrObject].NULL
            return res

        # The pieces are stored newest-first in the chain and the current buffer is
        # the newest of all, so we fill the fresh result from the end backwards.
        total = head.prev_length + head.pos
        result = StrObject.alloc(total)
        dst = total - head.pos
        ptr_copy_slice(result.utf8, dst, total, head.buf.utf8, 0, head.pos)

        node = head.prev
        while node != gc_ptr[Chunk].NULL:
            dst -= node.pos
            ptr_copy_slice(result.utf8, dst, dst + node.pos, node.buf.utf8, 0, node.pos)
            node = node.prev

        head.buf = gc_ptr[StrObject].NULL
        return StrObject.to_sealed_str(result)
