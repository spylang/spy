from _str import StrObject
from unsafe import gc_alloc, gc_ptr, ptr_copy_slice, ptr_setbytes_slice


@struct
class Chunk:
    buf: gc_ptr[StrObject]
    pos: i32  # bytes used in buf
    prev: gc_ptr[Chunk]
    prev_length: i32  # total bytes stored in the `prev` chain


@struct
class StrBuilder:
    """
    Build a string piece by piece, growing as needed.

        sb = StrBuilder(initial_capacity)
        sb.append("hello ")
        sb.append("world")
        s = sb.build()

    `initial_capacity` is the size in bytes of the first chunk.
    """

    __ll__: gc_ptr[Chunk]

    def __new__(initial_capacity: i32) -> StrBuilder:
        if initial_capacity < 0:
            raise ValueError("StrBuilder capacity must not be negative")

        head = gc_alloc[Chunk](1)
        head.buf = StrObject.alloc(initial_capacity)
        head.pos = 0
        head.prev = gc_ptr[Chunk].NULL
        head.prev_length = 0
        return StrBuilder.__make__(head)

    def append(self, s: str) -> None:
        head = self.__ll__
        if head.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")
        lls = StrObject.from_str(s)
        n = lls.length
        room = head.buf.length - head.pos
        if n <= room:
            # fast path: we can copy into the current chunk
            ptr_copy_slice(head.buf.utf8, head.pos, head.pos + n, lls.utf8, 0, n)
            head.pos += n
            return

        # slow path: we need to grow
        if room > 0:
            # fill the remaining of the current buffer
            ptr_copy_slice(head.buf.utf8, head.pos, head.pos + room, lls.utf8, 0, room)
            head.pos += room
        # grow and copy the rest
        rest = n - room
        self._grow(rest)
        ptr_copy_slice(head.buf.utf8, 0, rest, lls.utf8, room, n)
        head.pos = rest

    def _grow(self, needed: i32) -> None:
        """
        The current buffer is full: seal it into the chain and allocate a bigger one.
        """
        head = self.__ll__

        # move the existing buffer into a sealed chunk, and link it to the head
        sealed = gc_alloc[Chunk](1)
        sealed.buf = head.buf
        sealed.pos = head.pos
        sealed.prev = head.prev
        sealed.prev_length = head.prev_length

        head.prev = sealed
        head.prev_length += head.pos

        # allocate a new buffer for the head
        new_capacity = head.buf.length * 2
        if new_capacity < needed:
            new_capacity = needed
        head.buf = StrObject.alloc(new_capacity)
        head.pos = 0

    def build(self) -> str:
        """
        Return the string and seal the builder.
        """
        chunk = self.__ll__
        if chunk.buf == gc_ptr[StrObject].NULL:
            raise ValueError("StrBuilder is already built")

        if chunk.prev == gc_ptr[Chunk].NULL:
            # nothing overflowed the first chunk, so the buffer already is the result
            if chunk.pos < chunk.buf.length:
                # underfill: we didn't use all the space in buf. Let's just pretend
                # the StrObject is shorter. This leaks a bit of memory at the end,
                # too bad.
                chunk.buf.length = chunk.pos
            buf = chunk.buf
            chunk.buf = gc_ptr[StrObject].NULL
            return StrObject.to_str(buf)

        # The pieces are stored newest-first in the chain and the current buffer is
        # the newest of all, so we fill the fresh result from the end backwards.
        total = chunk.prev_length + chunk.pos
        result = StrObject.alloc(total)
        dst = total - chunk.pos
        ptr_copy_slice(result.utf8, dst, total, chunk.buf.utf8, 0, chunk.pos)

        node = chunk.prev
        while node != gc_ptr[Chunk].NULL:
            dst -= node.pos
            ptr_copy_slice(result.utf8, dst, dst + node.pos, node.buf.utf8, 0, node.pos)
            node = node.prev

        chunk.buf = gc_ptr[StrObject].NULL
        return StrObject.to_str(result)


# ========== UnsafeFixedStrBuilder ==========


@struct
class UnsafeBuilderState:
    buffer: gc_ptr[StrObject]
    position: i32


@struct
class UnsafeFixedStrBuilder:
    """
    Build a string in a fixed-size buffer, with capacity measured in bytes.

    This class is UNSAFE. No check is performed. It is up to the caller to ensure that
    the appended chunks fit in the capacity. If the final string is shorter than the
    capacity, build() just adjusts the length and the remaining bytes stay unused.

    The main consumer is str.join(list[str]), which needs to be fast and where you can
    easily precompute the exact capacity.  For a more general and safer way to build a
    string whose length is not known, use StrBuilder.
    """

    __ll__: gc_ptr[UnsafeBuilderState]

    def __new__(capacity: i32) -> UnsafeFixedStrBuilder:
        state = gc_alloc[UnsafeBuilderState](1)
        state.buffer = StrObject.alloc(capacity)
        state.position = 0
        return UnsafeFixedStrBuilder.__make__(state)

    def append(self, chunk: str) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        length = source.length
        if length > 0:
            ptr_copy_slice(
                state.buffer.utf8,
                state.position,
                state.position + length,
                source.utf8,
                0,
                length,
            )
            state.position = state.position + length

    def append_repeat(self, chunk: str, n: i32) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        total = source.length * n
        l = source.length
        if l == 1:
            # single-byte chunk (e.g. a fill char): use memset instead of n copies
            ptr_setbytes_slice(
                state.buffer.utf8,
                state.position,
                state.position + n,
                source.utf8[0],
            )
        else:
            for i in range(n):
                ptr_copy_slice(
                    state.buffer.utf8,
                    state.position + i * l,
                    state.position + (i + 1) * l,
                    source.utf8,
                    0,
                    l,
                )
        state.position = state.position + total

    def append_slice(self, chunk: str, start: i32, end: i32) -> None:
        state = self.__ll__
        source = StrObject.from_str(chunk)
        length = end - start
        if length > 0:
            ptr_copy_slice(
                state.buffer.utf8,
                state.position,
                state.position + length,
                source.utf8,
                start,
                end,
            )
            state.position = state.position + length

    def build(self) -> str:
        state = self.__ll__
        state.buffer.length = state.position
        return StrObject.to_sealed_str(state.buffer)
